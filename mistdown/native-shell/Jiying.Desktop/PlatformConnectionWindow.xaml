<Window x:Class="Jiying.Desktop.PlatformConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="连接官网" Width="1040" Height="760" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource DialogBrush}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,14,18,12">
            <TextBlock x:Name="ConnectionTitle" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ConnectionInstructions" Text="在官网按需扫码登录，打开目标视频后点击“使用此视频”。" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" Margin="18,12,18,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ConnectionStatus" Foreground="{DynamicResource SecondaryTextBrush}" Text="正在打开官网…" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <WrapPanel Grid.Column="1">
                <Button x:Name="HomeButton" Style="{DynamicResource GhostButton}" Content="官网首页" Margin="0,0,8,0" Click="Home_Click" IsEnabled="False"/>
                <Button x:Name="ReloadButton" Style="{DynamicResource GhostButton}" Content="刷新网页" Margin="0,0,8,0" Click="Reload_Click" IsEnabled="False"/>
                <Button x:Name="UseVideoButton" Style="{DynamicResource PrimaryButton}" Content="使用此视频" Click="UseVideo_Click" IsEnabled="False"/>
                <Button x:Name="CancelButton" Style="{DynamicResource GhostButton}" Content="取消" Click="Cancel_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
            </WrapPanel>
        </Grid>
        <wv:WebView2 x:Name="Website" Margin="1,0,1,0"/>
    </DockPanel>
</Window>
