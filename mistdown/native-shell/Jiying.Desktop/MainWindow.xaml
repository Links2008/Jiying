                                        <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="代理" Style="{StaticResource SettingLabel}"/><TextBlock Text="下载慢优先试「直连」，系统代理常常是慢的根源" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="ProxyModeBox" Width="180" SelectedValuePath="Tag" SelectionChanged="SettingsConfig_Changed"><ComboBoxItem Tag="system">跟随系统</ComboBoxItem><ComboBoxItem Tag="direct">直连</ComboBoxItem><ComboBoxItem Tag="custom">自定义</ComboBoxItem></ComboBox><TextBox x:Name="CustomProxyBox" Width="170" Margin="8,0,0,0" ToolTip="http://127.0.0.1:7890" LostFocus="SettingsTextConfig_Changed"/></StackPanel></Grid>
                                        <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="aria2c 多线程" Style="{StaticResource SettingLabel}"/><TextBlock Text="直链大文件 16 连接加速" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel><CheckBox x:Name="AriaCheck" Grid.Column="1" Style="{StaticResource SwitchCheckBox}" Click="SettingsConfig_Changed"/></Grid>
                                        <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="分段并发" Style="{StaticResource SettingLabel}"/><TextBlock Text="B站 / YouTube 分段流的并发线程数" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel><TextBox x:Name="FragmentsBox" Grid.Column="1" Text="16" LostFocus="SettingsTextConfig_Changed"/></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGroupBody}">
                                    <StackPanel>
                                        <DockPanel><Viewbox Width="17" Height="17" Margin="0,0,9,14"><Canvas Width="24" Height="24"><Path Data="M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 M12,9 L12.01,9 M11,12 L12,12 L12,16 L13,16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="外观与行为" Style="{StaticResource SettingHeading}"/></DockPanel>
                                        <Grid Style="{StaticResource SettingRow}" Margin="0,12,0,12" MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="自动解析剪贴板" Style="{StaticResource SettingLabel}"/></StackPanel><CheckBox x:Name="AutoParseCheck" Grid.Column="1" Style="{StaticResource SwitchCheckBox}" Click="UiOption_Changed"/></Grid>
                                        <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="强调色" Style="{StaticResource SettingLabel}"/><TextBlock Text="贯穿界面的唯一主题色" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AccentIconButton" Style="{StaticResource SwatchButton}" Margin="0,0,10,0" Background="#3050F0" Tag="icon" Click="Accent_Click" ToolTip="即影蓝"/><Button x:Name="AccentJadeButton" Style="{StaticResource SwatchButton}" Margin="0,0,10,0" Background="#68D5B5" Tag="jade" Click="Accent_Click" ToolTip="玉青"/><Button x:Name="AccentAmberButton" Style="{StaticResource SwatchButton}" Margin="0,0,10,0" Background="#E4A451" Tag="amber" Click="Accent_Click" ToolTip="蜜橙"/><Button x:Name="AccentIrisButton" Style="{StaticResource SwatchButton}" Background="#8CA8DC" Tag="iris" Click="Accent_Click" ToolTip="雾蓝"/></StackPanel></Grid>
                                        <Grid Style="{StaticResource SettingLastRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="背景透明度" Style="{StaticResource SettingLabel}"/><TextBlock Text="向左更通透、透出桌面，向右背板与雾彩更浓" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel><Slider x:Name="BackgroundOpacitySlider" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BackgroundOpacity_ValueChanged"/><TextBlock x:Name="BackgroundOpacityText" Grid.Column="2" Text="100%" Foreground="{DynamicResource MutedBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGroupBody}" Margin="0">
                                    <StackPanel>
                                        <DockPanel><Viewbox Width="17" Height="17" Margin="0,0,9,14"><Canvas Width="24" Height="24"><Path Data="M12,18 L6.657,18 C4.085,18 2,15.993 2,13.517 C2,11.042 4.085,9.035 6.657,9.035 C7.05,7.273 8.451,5.835 10.332,5.262 C12.212,4.69 14.288,5.069 15.776,6.262 C17.264,7.452 17.938,9.269 17.546,11.031 L18.536,11.031 C19.916,11.031 21.109,11.844 21.666,13.021 M19,16 L19,22 M22,19 L19,22 L16,19" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="解析引擎" Style="{StaticResource SettingHeading}"/></DockPanel>
                                        <Grid Style="{StaticResource SettingLastRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="跟随上游解析项目自动更新" Style="{StaticResource SettingLabel}"/><TextBlock Text="检查 yt-dlp 官方 GitHub 发布；校验通过后在下载空闲时生效" Style="{StaticResource Caption}" Margin="0,2,0,0"/><TextBlock x:Name="YtDlpStatusText" Text="自动更新已开启 · 正在读取版本" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><Button x:Name="YtDlpCheckButton" Grid.Column="1" Style="{StaticResource GhostButton}" Click="YtDlpCheck_Click" AutomationProperties.Name="检查更新"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock x:Name="YtDlpCheckLabel" Text="检查更新" VerticalAlignment="Center"/></StackPanel></Button></Grid>
                                    </StackPanel>
                                </Border>
                                </StackPanel></Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
