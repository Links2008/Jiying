        <Image x:Name="ThemeTransitionLayer" Panel.ZIndex="200" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="WindowDragSurface" Panel.ZIndex="35" Height="48" VerticalAlignment="Top" Background="#01000000" IsHitTestVisible="False"/>

        <StackPanel x:Name="WindowControls" Panel.ZIndex="160" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" MouseEnter="WindowControls_MouseEnter" MouseLeave="WindowControls_MouseLeave" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="WMin" Style="{StaticResource WindowDotButton}" Width="20" Height="20" ToolTip="最小化" Click="WindowMin_Click" AutomationProperties.Name="最小化">
                <Grid><Ellipse x:Name="WMinDot" Width="12" Height="12" Fill="#FEBC2E"/><TextBlock x:Name="WMinGlyph" Text="−" Foreground="#D6161616" FontWeight="Bold" FontSize="10" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Grid>
            </Button>
            <Button x:Name="WMax" Style="{StaticResource WindowDotButton}" Width="20" Height="20" ToolTip="最大化 / 还原" Click="WindowMax_Click" Margin="8,0,0,0" AutomationProperties.Name="最大化 / 还原">
                <Grid><Ellipse x:Name="WMaxDot" Width="12" Height="12" Fill="#28C840"/><TextBlock x:Name="WMaxGlyph" Text="↗" Foreground="#D6161616" FontWeight="Bold" FontSize="9" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
            </Button>
            <Button x:Name="WClose" Style="{StaticResource WindowDotButton}" Width="20" Height="20" ToolTip="关闭" Click="WindowClose_Click" Margin="8,0,0,0" AutomationProperties.Name="关闭">
                <Grid><Ellipse x:Name="WCloseDot" Width="12" Height="12" Fill="#FF5F57"/><TextBlock x:Name="WCloseGlyph" Text="×" Foreground="#D6161616" FontWeight="Bold" FontSize="10" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
            </Button>
        </StackPanel>

        <StackPanel x:Name="ToastHost" Panel.ZIndex="210" Width="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22"/>

        <Grid x:Name="ModalOverlay" Panel.ZIndex="120" Visibility="Collapsed" Background="#8C06090E">
            <Grid.Resources><SolidColorBrush x:Key="CardBrush" Color="#FF20252E"/></Grid.Resources>
            <Border x:Name="DirectoryDialog" Visibility="Collapsed" Width="560" MaxHeight="620" Style="{StaticResource SectionCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseModal_Click" AutomationProperties.Name="关闭"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></StackPanel></Button><TextBlock Text="选择输出目录" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel><WrapPanel x:Name="DrivePanel" Grid.Row="1" Margin="0,14,0,7"/><TextBlock x:Name="DirectoryCurrentText" Grid.Row="2" Style="{StaticResource Caption}" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap"/><ListBox x:Name="DirectoryListBox" Grid.Row="3" Margin="0,12,0,12" MinHeight="260" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MouseDoubleClick="DirectoryList_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Border Padding="11,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><DockPanel Grid.Row="4"><StackPanel Orientation="Horizontal"><Button x:Name="DirectoryUpButton" Style="{StaticResource GhostButton}" Click="DirectoryUp_Click" AutomationProperties.Name="上一级"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconBack}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="上一级" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource GhostButton}" Click="DirectoryHome_Click" Margin="7,0,0,0" AutomationProperties.Name="主目录"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconHome}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="主目录" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="DirectoryAccept_Click" AutomationProperties.Name="选择此目录"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconTick}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="选择此目录" VerticalAlignment="Center"/></StackPanel></Button></DockPanel></Grid>
            </Border>

            <Border x:Name="SubtitleDialog" Visibility="Collapsed" Width="940" MaxHeight="650" Margin="24"
                    MaxWidth="{Binding ActualWidth, ElementName=ModalOverlay}" Background="{DynamicResource DialogBrush}" Style="{StaticResource SectionCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="SubtitleCloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseModal_Click" AutomationProperties.Name="关闭字幕编辑器">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        </Button>
                        <TextBlock x:Name="SubtitleDialogTitle" Text="修改字幕" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="SubtitleEditorDescription" Grid.Row="1" Text="直接点击文字修改，时间轴自动保留。重新生成会复用已下载的视频。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <DataGrid x:Name="SubtitleRows" Grid.Row="2" Margin="0,14,0,12" MinHeight="250" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                              Background="Transparent" Foreground="{DynamicResource TextBrush}" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="逐条字幕编辑">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="10,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/></Style>
                            <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="56"/></Style>
                            <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="时间" Width="112" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Margin="10,10"><TextBlock Text="{Binding Number}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="{Binding TimingDisplay}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="SubtitleReferenceColumn" Header="原文 · 对照" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding ReferenceText}" TextWrapping="Wrap" FontSize="13" Margin="10,10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="SubtitleEditColumn" Header="当前字幕 · 点击修改" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SubtitleCueEditor}" AutomationProperties.Name="{Binding Number, StringFormat=修改第 {0} 条字幕}"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox x:Name="SubtitleTextBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="{DynamicResource MonoFont}"
                             FontSize="12.5" TextBlock.LineHeight="21.25" TextBlock.LineStackingStrategy="BlockLineHeight" Margin="0,14,0,12"
                             MinHeight="180" AutomationProperties.Name="字幕内容"/>
                    <WrapPanel Grid.Row="3">
                        <Button x:Name="SubtitleSaveButton" Content="仅保存字幕" Style="{StaticResource GhostButton}" Click="SaveSubtitle_Click" Margin="0,0,8,0" AutomationProperties.Name="仅保存字幕"/>
                        <Button x:Name="SubtitleRenderButton" Content="保存并重新生成视频" Style="{StaticResource PrimaryButton}" Click="RerenderSubtitle_Click" AutomationProperties.Name="保存并重新生成视频"/>
                    </WrapPanel>
                    <TextBlock x:Name="SubtitleHint" Grid.Row="4" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <Border x:Name="DeleteDialog" Visibility="Collapsed" Width="520" MaxHeight="560" Style="{StaticResource SectionCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseModal_Click" AutomationProperties.Name="关闭"><TextBlock Text="×" FontSize="18"/></Button>
                        <TextBlock x:Name="DeleteDialogTitle" Text="删除下载内容" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="DeleteDescription" Grid.Row="1" Style="{StaticResource Caption}" Margin="0,12,0,14" TextWrapping="Wrap"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <RadioButton x:Name="DeleteSubtitleChoice" Grid.Column="0" GroupName="DeleteScope" Tag="subtitle" Style="{StaticResource DeleteChoice}" Checked="DeleteChoice_Changed" AutomationProperties.Name="只删除字幕"><StackPanel><TextBlock Text="字幕" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="SRT 文件" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></RadioButton>
                        <RadioButton x:Name="DeleteVideoChoice" Grid.Column="1" GroupName="DeleteScope" Tag="video" Style="{StaticResource DeleteChoice}" Checked="DeleteChoice_Changed" AutomationProperties.Name="只删除视频"><StackPanel><TextBlock Text="视频" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="原片与成片" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></RadioButton>
                        <RadioButton x:Name="DeleteAllChoice" Grid.Column="2" GroupName="DeleteScope" Tag="all" Style="{StaticResource DeleteChoice}" Margin="0" Checked="DeleteChoice_Changed" AutomationProperties.Name="删除全部和记录"><StackPanel><TextBlock Text="全部" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="文件与记录" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></RadioButton>
                    </Grid>
                    <DockPanel Grid.Row="3" Margin="0,18,0,0">
                        <TextBlock x:Name="DeleteHint" Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="215"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="取消" Click="CloseModal_Click"/>
                            <Button x:Name="ConfirmDeleteButton" Style="{StaticResource DangerButton}" Click="ConfirmDelete_Click" Margin="7,0,0,0" AutomationProperties.Name="确认删除"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconTrash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock x:Name="ConfirmDeleteText" Text="删除全部" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
